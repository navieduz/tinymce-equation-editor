{
  "name": "@naviedu/tinymce-equation-plugin",
  "version": "1.1.14",
  "packageManager": "yarn@4.15.0",
  "description": "Equation Editor plugin for TinyMCE that uses MathLive",
  "scripts": {
    "prepublishOnly": "npm run lint && npm run build",
    "lint": "tslint src/**/*.ts",
    "build": "grunt",
    "test": "node_modules/@ephox/bedrock/bin/bedrock-auto.js --browser chrome -d src/test/ts/",
    "test-manual": "node_modules/@ephox/bedrock/bin/bedrock.js -d src/test/ts/",
    "unit": "mocha",
    "start": "NODE_OPTIONS=--openssl-legacy-provider && grunt webpack"
  },
  "keywords": [],
  "author": "insoutt",
  "devDependencies": {
    "@ephox/agar": "4.17.0",
    "@ephox/bedrock": "8.1.1",
    "@ephox/mcagar": "4.2.2",
    "@ephox/swag": "4.2.1",
    "@ephox/tslint-rules": "1.1.1",
    "@types/mocha": "^7.0.2",
    "awesome-typescript-loader": "^5.2.1",
    "chai": "^4.2.0",
    "grunt": "^1.0.3",
    "grunt-contrib-clean": "^2.0.0",
    "grunt-contrib-concat": "^1.0.1",
    "grunt-contrib-copy": "^1.0.0",
    "grunt-shell": "^2.1.0",
    "grunt-terser": "2.0.0",
    "grunt-tslint": "^5.0.2",
    "grunt-webpack": "^3.1.3",
    "http-server": "^0.11.1",
    "load-grunt-tasks": "^4.0.0",
    "mocha": "^6.2.2",
    "terser": "5.49.0",
    "tinymce": "^5.6.0",
    "ts-loader": "^5.3.0",
    "ts-node": "^8.0.2",
    "tslib": "^1.9.3",
    "tslint": "^5.11.0",
    "typescript": "5.6.3",
    "webpack": "^4.25.1",
    "webpack-livereload-plugin": "^2.1.1"
  },
  "files": [
    "dist",
    "lib/main",
    "lib/demo",
    "lib/test",
    "src",
    "tsconfig.json",
    "readme.md",
    "LEGAL.txt",
    "CHANGELOG.txt",
    "LICENSE.txt"
  ],
  "main": "./lib/main/ts/api/Main.js",
  "module": "./lib/main/ts/api/Main.js",
  "types": "./lib/main/ts/api/Main.d.ts",
  "license": "MIT",
  "directories": {
    "lib": "lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navieduz/tinymce-equation-editor.git"
  },
  "bugs": {
    "url": "https://github.com/navieduz/tinymce-equation-editor/issues"
  },
  "homepage": "https://github.com/navieduz/tinymce-equation-editor#readme",
  "dependencies": {
    "mathlive": "^0.110.0"
  }
}
